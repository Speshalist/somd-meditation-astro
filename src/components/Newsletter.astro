---

<section class="py-20 bg-sage-800 text-white">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold mb-3">Stay Connected</h2>
    <p class="text-sage-200 mb-8 leading-relaxed">
      Get notified about upcoming gatherings, pop-up labyrinth meditations, and community news. 
      No spam — just peaceful updates.
    </p>

    {/* 
      EmailOctopus Embedded Form
      Replace the div below with your EmailOctopus embed code.
      Go to EmailOctopus → Forms → Embedded HTML → copy the <form> snippet.
    */}
    <div class="bg-white/10 backdrop-blur rounded-xl p-6 border border-white/10">
      <p class="text-sm text-sage-200 mb-4">
        📬 Paste your EmailOctopus embed code here. 
        <a href="https://emailoctopus.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-white">Get your form code</a>
      </p>

      {/* Example structure — swap this out */}
      <form 
        action="https://emailoctopus.com/lists/YOUR-LIST-ID/members/embedded/1.3s/add" 
        method="post"
        class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
      >
        <input
          type="email"
          name="field_0"
          placeholder="Enter your email"
          required
          class="flex-1 px-4 py-3 rounded-lg bg-white text-sage-900 placeholder-sage-400 border-0 focus:ring-2 focus:ring-teal-400 outline-none"
        />
        <button
          type="submit"
          class="px-6 py-3 rounded-lg bg-teal-500 hover:bg-teal-400 text-white font-medium transition-colors"
        >
          Subscribe
        </button>
      </form>
      <p class="text-xs text-sage-400 mt-3">
        We respect your privacy. Unsubscribe at any time.
      </p>
    </div>
  </div>
</section>
