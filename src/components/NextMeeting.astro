<section class="py-16 bg-teal-50" id="join">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-sm border border-teal-100 p-6 sm:p-10 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-teal-100 text-teal-800 text-xs font-semibold uppercase tracking-wider mb-4">
        Next Gathering
      </span>

      <h2 class="text-2xl sm:text-3xl font-bold text-sage-900 mb-2">
        Evening Mindfulness Practice
      </h2>

      <p id="next-date" class="text-lg text-teal-700 font-medium mb-6">
        Calculating next date...
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left mb-8">
        <div class="bg-sand-50 rounded-xl p-4">
          <div class="text-sage-500 text-xs uppercase tracking-wider font-semibold mb-1">When</div>
          <p class="text-sage-800 font-medium">2nd & 4th Thursdays</p>
          <p class="text-sage-600 text-sm">6:30 – 8:00 PM</p>
        </div>
        <div class="bg-sand-50 rounded-xl p-4">
          <div class="text-sage-500 text-xs uppercase tracking-wider font-semibold mb-1">Where</div>
          <p class="text-sage-800 font-medium">Solomons Mission Center</p>
          <p class="text-sage-600 text-sm">14454 Solomons Island Rd, Solomons, MD</p>
        </div>
        <div class="bg-sand-50 rounded-xl p-4">
          <div class="text-sage-500 text-xs uppercase tracking-wider font-semibold mb-1">Cost</div>
          <p class="text-sage-800 font-medium">Free</p>
          <p class="text-sage-600 text-sm">Donations to The Mission gratefully accepted</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="https://maps.google.com/?q=14454+Solomons+Island+Road+Solomons+MD"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-sage-800 text-white text-sm font-medium hover:bg-sage-900 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Get Directions
        </a>
        <a
          href="/agreements"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-sage-300 text-sage-700 text-sm font-medium hover:bg-sage-50 transition-colors"
        >
          Read Group Agreements
        </a>
      </div>

      <p class="mt-6 text-sm text-sage-500">
        Everyone is welcome. Our practice is universal and non-sectarian.
      </p>
    </div>
  </div>
</section>

<script>
  function getNextMeetingDate() {
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth();

    function getNthThursday(y: number, m: number, n: number) {
      const firstDay = new Date(y, m, 1);
      let thursdayCount = 0;
      for (let d = 1; d <= 31; d++) {
        const date = new Date(y, m, d);
        if (date.getMonth() !== m) break;
        if (date.getDay() === 4) { // Thursday
          thursdayCount++;
          if (thursdayCount === n) return date;
        }
      }
      return null;
    }

    const secondThu = getNthThursday(year, month, 2);
    const fourthThu = getNthThursday(year, month, 4);

    const candidates = [secondThu, fourthThu].filter((d): d is Date => d !== null);
    const future = candidates.filter(d => {
      const meetingEnd = new Date(d);
      meetingEnd.setHours(20, 0, 0, 0);
      return meetingEnd > now;
    });

    if (future.length > 0) return future[0];

    // Check next month
    const nextMonth = month === 11 ? 0 : month + 1;
    const nextYear = month === 11 ? year + 1 : year;
    const nextSecond = getNthThursday(nextYear, nextMonth, 2);
    if (nextSecond) return nextSecond;

    return null;
  }

  const nextDate = getNextMeetingDate();
  const el = document.getElementById("next-date");
  if (el && nextDate) {
    const options: Intl.DateTimeFormatOptions = { 
      weekday: 'long', 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric' 
    };
    el.textContent = nextDate.toLocaleDateString('en-US', options);
  }
</script>
